# Local Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) — use with prisma/schema.postgresql.prisma
# DATABASE_URL="postgresql://homistry:password@localhost:5432/homistry?schema=public"

# Auth.js / NextAuth configuration
AUTH_SECRET="replace-with-32-byte-hex-secret-in-production"
NEXTAUTH_SECRET="replace-with-32-byte-hex-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
